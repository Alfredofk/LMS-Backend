// LMS spine schema.
//
// Scope is deliberate: identity, tenancy, membership, and the academic skeleton
// the registration and teaching-assignment features hang on. Content, assessment,
// grading, tracking, gamification and reporting arrive with their own features.
//
// Tenancy rule (ADR-0001): every model below carries `schoolId` EXCEPT
// User, EmailVerificationToken, PasswordResetToken, PlatformAdmin,
// SchoolRegistration and School. Those six are listed in src/shared/prisma.js as
// exempt; adding a model here without `schoolId` and without adding it there
// will make the tenant extension throw on first use, which is the intended
// failure mode.
//
// Several uniqueness rules cannot be expressed in this DSL because they are
// partial (filtered) indexes. They live in hand-written migration SQL - see
// prisma/partial-indexes.sql. Do not "fix" their absence here with
// plain @@unique: rejected and departed rows must be free to repeat.

generator client {
    provider = "prisma-client-js"
}

// DATABASE_URL carries options=-c%20plan_cache_mode%3Dforce_custom_plan on every host
// (grading-and-report-card 05, owner 2026-10-19). Every query holds the tenant filter
// "schoolId" = $n, and after five runs of a prepared statement Postgres may keep a generic
// plan that takes each school for an equal share of a table: for a school holding most of
// Score it read the whole school, 731-837 ms against 2 ms. Without the option nothing fails,
// it only gets slow; SHOW plan_cache_mode on the app's connection tells.
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SchoolType {
    SD
    SMP
    SMA
    SMK
}

/// Indonesia's three time zones, each a fixed offset - there is no daylight saving:
/// WIB UTC+7, WITA UTC+8, WIT UTC+9. A school's schedule is written in its own
/// (teaching-and-learning ticket 07); src/shared/timeZone.js converts.
enum SchoolTimeZone {
    WIB
    WITA
    WIT
}

/// No value is ever named WALI: Indonesian shortens both wali kelas (homeroom
/// teacher) and wali murid (guardian) to "wali", and they are different people
/// with different access. Homeroom teacher is not a role at all - it is
/// Class.homeroomTeacherMembershipId, because a role cannot express WHICH class.
enum SchoolRole {
    PRINCIPAL
    TEACHER
    STUDENT
    GUARDIAN
    /// Wakil kepala sekolah (registration-and-membership ticket 19): a TEACHER the
    /// Principal appoints to run the academic day-to-day - years, classes, teaching
    /// assignments, the timetable, holidays. Never hiring, removing, leave requests or
    /// the school's identity. Several per school, all alike. Never asked for.
    VICE_PRINCIPAL
}

enum ApprovalStatus {
    PENDING
    ACTIVE
    REJECTED
    /// Taken back by the person who asked, before anybody decided (owner, 2026-09-23).
    /// Not REJECTED: nobody turned it down, and it never counts against a retry cap.
    CANCELLED
    /// A role taken off a membership that stays ACTIVE - so far only PRINCIPAL, when the
    /// school is handed to a new Principal (owner, 2026-09-27). Every check reads
    /// status ACTIVE, so an ended role grants nothing without anyone having to know
    /// about this value. A role of a LEFT membership is not ENDED: it keeps its status
    /// as history, and the membership's status is what ends its access.
    ENDED
}

enum MembershipStatus {
    PENDING
    ACTIVE
    REJECTED
    LEFT
    /// A join request its applicant withdrew while it was still PENDING.
    CANCELLED
}

enum RegistrationStatus {
    PENDING
    APPROVED
    REJECTED
}

enum AcademicYearStatus {
    ACTIVE
    CLOSED
}

enum SemesterStatus {
    OPEN
    FINALIZING
    CLOSED
}

enum PromotionOutcome {
    PROMOTED
    RETAINED
    GRADUATED
}

enum ApprovalAction {
    SUBMIT
    APPROVE
    REJECT
    REMOVE
    LEAVE
    OVERRIDE
    REGENERATE_CODE
    /// A platform admin withdrawing, or restoring, a whole school's access.
    /// Its own value rather than REMOVE, which means removing one member from a
    /// school - a reader of the audit log should not need subjectType to tell
    /// a school being switched off from a teacher being let go.
    DEACTIVATE
    REACTIVATE
    /// The person who asked taking a PENDING request back.
    CANCEL
    /// The school handed to a new Principal, by the one before or by a Platform Admin.
    HANDOVER
    /// The Principal correcting the school's point on the map (teaching-and-learning 01).
    UPDATE_LOCATION
    /// The Principal changing the school's time zone (teaching-and-learning 07).
    UPDATE_TIME_ZONE
    /// The Principal changing the school's letterhead - its address, its phone or its
    /// logo (grading-and-report-card 10).
    UPDATE_LETTERHEAD
    /// A holiday taken back - a national one by an admin, a school one by its Principal.
    WITHDRAW
    /// The Principal switching whether the school observes joint leave.
    UPDATE_JOINT_LEAVE
    /// A teaching assignment ended, or replaced, while its teacher stays in the school
    /// (teaching-and-learning 10). Not REMOVE, which is a member leaving the school.
    END
    /// The Principal or a Vice Principal selecting, or deselecting, a national Subject
    /// for the school (registration-and-membership 20).
    UPDATE_SUBJECTS
    /// The Principal or a Vice Principal changing the school's default Grade Weights,
    /// its default KKTP, or its Remedial Rule (grading-and-report-card 01).
    UPDATE_GRADE_SETTINGS
    /// The Principal moving a Semester from OPEN to FINALIZING, and back while no slot
    /// of it is finalised (grading-and-report-card 04).
    START_FINALIZING
    STOP_FINALIZING
    /// The Principal closing a Semester, which writes its Report Cards
    /// (grading-and-report-card 05).
    CLOSE_SEMESTER
    /// The Principal taking a CLOSED Semester back to FINALIZING, with a reason: one row
    /// against the Semester, and one against each SlotFinalisation it undoes
    /// (grading-and-report-card 06).
    REOPEN_SEMESTER
    /// A Platform Admin changing a School's subdomain (governing-body ticket 02). The old
    /// one stops resolving at once.
    UPDATE_SUBDOMAIN
    /// A Platform Admin correcting a Governing Body's name, kind or SK number
    /// (governing-body ticket 03).
    UPDATE_GOVERNING_BODY
}

/// What a Governing Body is (governing-body spec, K1): UU Sisdiknas's *penyelenggara
/// pendidikan*, the body that runs a school.
enum GoverningBodyKind {
    /// A yayasan.
    FOUNDATION
    /// A perkumpulan.
    ASSOCIATION
    /// A Dinas Pendidikan, of a kabupaten/kota (SD, SMP) or a province (SMA, SMK).
    GOVERNMENT
}

// ---------------------------------------------------------------------------
// Identity - above tenancy, never filtered by school
// ---------------------------------------------------------------------------

/// A person's account. Belongs to no school: affiliation is SchoolMembership.
/// This is the one table the tenant extension must never touch.
model User {
    id              String    @id @default(cuid())
    email           String    @unique
    /// Null for an account created through Google until forgot-password sets one.
    passwordHash    String?
    /// Google's stable account id (the ID token's `sub`), never its email (ADR-0005).
    googleSub       String?   @unique
    fullName        String
    /// The person's own number, the same whichever school they are at
    /// (registration-and-membership ticket 23). Asked of a guardian, changed only
    /// by them, read by the Principal and the Vice Principals; null once the
    /// account is deleted.
    phone           String?
    emailVerifiedAt DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    platformAdmin          PlatformAdmin?
    memberships            SchoolMembership[]
    emailVerificationToken EmailVerificationToken[]
    passwordResetTokens    PasswordResetToken[]
    refreshTokens          RefreshToken[]
    handoffCodes           HandoffCode[]
    governingBodyRegistrations GoverningBodyRegistration[] @relation("GoverningBodyRegistrationApplicant")
    governingBodySeats     GoverningBodyAdmin[]
    schoolRegistrations    SchoolRegistration[]     @relation("RegistrationApplicant")

    @@index([deletedAt])
}

/// Stored hashed and single-use. A leaked database hands over no live tokens.
model EmailVerificationToken {
    id        String    @id @default(cuid())
    userId    String
    tokenHash String    @unique
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model PasswordResetToken {
    id        String    @id @default(cuid())
    userId    String
    tokenHash String    @unique
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

/// A live session. Stored hashed like the two above, and rotated on every
/// refresh: the old row is revoked and points at the one that replaced it.
///
/// This table is the whole reason logout means anything. A stateless refresh
/// JWT cannot be taken back, so a stolen one would stay valid for its full TTL
/// no matter what the user did. Presenting an already-revoked row is the
/// signature of a leaked token - the chain for that user is then cut entirely.
model RefreshToken {
    id                String    @id @default(cuid())
    userId            String
    /// The Place this sign-in is for (governing-body ticket 01, ADR-0011): every
    /// refresh rebuilds this School's claims, and deactivating it revokes this row.
    /// Null for none yet - an applicant, a row issued before the ticket, or one who
    /// belongs to several Schools and has chosen none. Such a row takes the one
    /// ACTIVE School at its next refresh. Not a tenant column: RefreshToken is
    /// identity, above tenancy (UNSCOPED_MODELS).
    schoolId          String?
    tokenHash         String    @unique
    expiresAt         DateTime
    revokedAt         DateTime?
    /// The row that superseded this one. A rotation chain, for forensics.
    replacedByTokenId String?
    createdAt         DateTime  @default(now())

    /// The Place when it is a Governing Body seat (governing-body ticket 03), in place of
    /// schoolId: a row names one or the other, or neither.
    governingBodyId   String?

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    school        School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
    governingBody GoverningBody? @relation(fields: [governingBodyId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([userId, revokedAt])
    @@index([schoolId, revokedAt])
    @@index([governingBodyId, revokedAt])
}

/// A single-use code that carries a sign-in to another of the person's Places, on
/// another subdomain (governing-body ticket 02, K3). Stored hashed like the tokens
/// above, good for 60 seconds, bound to the User and the School it opens. Above
/// tenancy, like RefreshToken: schoolId names the target, not a tenant.
model HandoffCode {
    id               String    @id @default(cuid())
    userId           String
    /// The Place it opens: a School, or a Governing Body seat (governing-body ticket 03).
    /// Exactly one of the two is set.
    schoolId         String?
    governingBodyId  String?
    /// The refresh token row of the sign-in that asked for it. The code redeems only
    /// while that sign-in lives - its rotations followed - so a sign-out, a password
    /// change or a deletion in between voids it.
    sourceTokenId    String
    codeHash         String    @unique
    expiresAt        DateTime
    /// When the sign-in that asked for it ends: the new one ends no later (K3).
    sessionExpiresAt DateTime
    rememberMe       Boolean
    usedAt           DateTime?
    createdAt        DateTime  @default(now())

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    school        School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    governingBody GoverningBody? @relation(fields: [governingBodyId], references: [id], onDelete: Cascade)

    @@index([userId])
}

/// The platform operator, above every school. Not a school role - no School has
/// one. Seeded from env; no HTTP route creates one.
model PlatformAdmin {
    id        String   @id @default(cuid())
    userId    String   @unique
    createdAt DateTime @default(now())

    user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    reviewedRequests  SchoolRegistration[] @relation("RegistrationReviewer")
    deactivatedSchools School[]            @relation("SchoolDeactivatedBy")
    confirmedHolidays NationalHoliday[]
    reviewedGoverningBodyRegistrations GoverningBodyRegistration[] @relation("GoverningBodyRegistrationReviewer")
    deactivatedGoverningBodies         GoverningBody[]             @relation("GoverningBodyDeactivatedBy")
}

// ---------------------------------------------------------------------------
// Governing Bodies - a tier above the School (governing-body ticket 03, ADR-0010)
// ---------------------------------------------------------------------------
//
// Above tenancy, as a User and a School Registration are: none of these carries a
// tenant schoolId, and all are listed in UNSCOPED_MODELS. A Governing Body reads a
// School only through runInSchool, one School at a time (the spec's invariant 1).

/// A yayasan, perkumpulan or Dinas asking to be a Governing Body, checked by hand by
/// a Platform Admin as a School Registration is. Both files go the moment a decision
/// is made (UU PDP 27/2022); the numbers stay.
model GoverningBodyRegistration {
    id              String            @id @default(cuid())
    applicantUserId String
    kind            GoverningBodyKind
    name            String
    /// The Kemenkumham SK (pengesahan badan hukum), normalised: trimmed, uppercase,
    /// spaces collapsed. A FOUNDATION's or an ASSOCIATION's; a GOVERNMENT has none.
    skNumber        String?
    /// The full address (K5). Every part required but the postal code (owner, 2026-10-22).
    street          String
    /// Kelurahan or desa.
    village         String
    /// Kecamatan.
    district        String
    /// Kota or kabupaten - the subdomain's tie-break (K13).
    city            String
    province        String
    postalCode      String?
    applicantPhone  String
    ktpStoragePath  String?
    /// The akta page listing the pengurus, or the Kepala Dinas's surat tugas.
    proofStoragePath String?
    status          RegistrationStatus @default(PENDING)
    reviewedByAdminId String?
    reviewedAt      DateTime?
    rejectionReason String?
    createdGoverningBodyId String?    @unique
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    applicant            User           @relation("GoverningBodyRegistrationApplicant", fields: [applicantUserId], references: [id])
    reviewedBy           PlatformAdmin? @relation("GoverningBodyRegistrationReviewer", fields: [reviewedByAdminId], references: [id])
    createdGoverningBody GoverningBody? @relation(fields: [createdGoverningBodyId], references: [id])

    @@index([status])
    @@index([applicantUserId])
    @@index([skNumber])
}

/// A Governing Body: above its Schools, and a Place a sign-in can be for (ADR-0011).
/// Its admins hold seats (GoverningBodyAdmin).
model GoverningBody {
    id         String            @id @default(cuid())
    kind       GoverningBodyKind
    name       String
    /// Unique on the platform, as an NPSN is (K5). Null for a GOVERNMENT body.
    skNumber   String?           @unique
    street     String
    village    String
    district   String
    city       String
    province   String
    postalCode String?
    /// The body's own number, set by its admins with the address (governing-body ticket 04).
    /// The founding applicant's stays on the registration.
    phone      String?
    /// The Governing Body Code: the School Code's 8 characters and alphabet. Locates the
    /// body; grants nothing (ticket 04 takes admin applications through it; a Principal
    /// applies through the School's own code, ticket 06). Any admin rotates it; the old one
    /// stops at once.
    code       String            @unique
    /// Its label under the base domain (K13), unique across Schools and bodies.
    subdomain  String            @unique
    /// Switched off by a Platform Admin (K11): its admins lose it, its code and subdomain
    /// stop resolving, the sign-ins bound to it end. Its Schools keep running.
    deactivatedAt        DateTime?
    deactivationReason   String?
    deactivatedByAdminId String?
    createdAt  DateTime          @default(now())
    updatedAt  DateTime          @updatedAt

    deactivatedBy PlatformAdmin?             @relation("GoverningBodyDeactivatedBy", fields: [deactivatedByAdminId], references: [id])
    registration  GoverningBodyRegistration?
    admins        GoverningBodyAdmin[]
    schools       School[]
    refreshTokens RefreshToken[]
    handoffCodes  HandoffCode[]

    @@index([deactivatedAt])
}

/// A person's seat as an admin of a Governing Body. The applicant gets the first, ACTIVE
/// at approval (ticket 03); others ask through the code (ticket 04). The senior admin is
/// the live one approved earliest (K6), so approvedAt is kept. One PENDING-or-ACTIVE seat
/// per person per body, by a partial index in partial-indexes.sql.
///
/// Its statuses are a membership's: PENDING, then ACTIVE or REJECTED, or CANCELLED by the
/// applicant; an ACTIVE seat ends LEFT, by leaving or by the senior's removal.
model GoverningBodyAdmin {
    id              String           @id @default(cuid())
    governingBodyId String
    userId          String
    status          MembershipStatus @default(PENDING)
    approvedAt      DateTime?
    endedAt         DateTime?
    /// Why the senior turned the application down, shown to the applicant (ticket 04).
    rejectionReason String?
    /// Why a LEFT seat ended: the senior's reason for a removal, or an account's deletion.
    /// Null for a plain leave, as SchoolMembership.endReason is.
    endReason       String?
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt

    governingBody GoverningBody @relation(fields: [governingBodyId], references: [id], onDelete: Cascade)
    user          User          @relation(fields: [userId], references: [id])

    @@index([governingBodyId, status])
    @@index([userId])
}

// ---------------------------------------------------------------------------
// Holidays - no Session is generated on one (teaching-and-learning ticket 08)
// ---------------------------------------------------------------------------

enum HolidayKind {
    /// Libur nasional: every school is off.
    NATIONAL
    /// Cuti bersama: meant for civil servants; a school is off only if it observes it.
    JOINT_LEAVE
}

enum HolidayStatus {
    /// Fetched from a community source and not yet checked against the SKB 3 Menteri.
    /// Counts for nothing.
    DRAFT
    CONFIRMED
    /// Taken back. Kept, never deleted; counts for nothing.
    WITHDRAWN
}

/// The government's national holidays and joint leave (SKB 3 Menteri, each year),
/// kept by the Platform Admin. Belongs to no school - listed in UNSCOPED_MODELS.
///
/// There is no official API. A draft is fetched from a community one and counts only
/// once an admin confirms it (owner, 2026-09-27): that source is scraped from a
/// third party, and it missed one of 2026's eight joint-leave days.
model NationalHoliday {
    id                 String        @id @default(cuid())
    /// A calendar date, the same across Indonesia's three zones.
    date               DateTime      @db.Date
    name               String
    kind               HolidayKind
    status             HolidayStatus @default(DRAFT)
    /// Where it came from: 'api-hari-libur' or 'manual'.
    source             String
    /// The name exactly as the source gave it, null for one added by hand. A later
    /// fetch recognises the day by this, not by `name`, which an admin may correct -
    /// or every correction would come back as a fresh draft beside it.
    sourceName         String?
    confirmedByAdminId String?
    confirmedAt        DateTime?
    withdrawnAt        DateTime?
    createdAt          DateTime      @default(now())
    updatedAt          DateTime      @updatedAt

    confirmedBy   PlatformAdmin?           @relation(fields: [confirmedByAdminId], references: [id])
    schoolChoices SchoolJointLeaveChoice[]

    // One row per day and name, so fetching a year twice adds nothing twice.
    @@unique([date, name])
    @@index([status, date])
}

/// A day or days one school is off - a school event, a regional holiday - set by
/// its Principal. Withdrawn rather than deleted.
model SchoolHoliday {
    id                String    @id @default(cuid())
    schoolId          String
    startDate         DateTime  @db.Date
    endDate           DateTime  @db.Date
    name              String
    createdByUserId   String
    withdrawnAt       DateTime?
    withdrawnByUserId String?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    @@index([schoolId, startDate])
}

enum ExamWeekType {
    UTS
    UAS
}

/// A run of a Semester's days with no teaching for the grade levels it names, kept for a
/// UTS or a UAS (teaching-and-learning ticket 13, owner 2026-10-18). Its days keep those
/// Classes' Sessions away as a holiday does, and a UTS or a UAS of theirs is published
/// inside one of its type. Not a holiday: other grade levels are taught as usual. Set
/// by the Principal or a Vice Principal; withdrawn rather than deleted, and never edited.
model ExamWeek {
    id                String       @id @default(cuid())
    schoolId          String
    semesterId        String
    type              ExamWeekType
    name              String
    startDate         DateTime     @db.Date
    endDate           DateTime     @db.Date
    /// Every Class of these grade levels in the Semester's year, e.g. [7, 8, 9].
    gradeLevels       Int[]
    createdByUserId   String
    withdrawnAt       DateTime?
    withdrawnByUserId String?
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt

    school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

    @@index([schoolId, startDate])
    @@index([semesterId])
}

/// A school's choice for ONE joint-leave day, overriding its School.observesJointLeave
/// default (owner, 2026-09-27): a Principal may take Idul Fitri's joint leave and not
/// Christmas Eve's. `observed` null means "follow the school's default" - so going
/// back to the default needs no delete. Ignored unless the day is a CONFIRMED
/// JOINT_LEAVE.
model SchoolJointLeaveChoice {
    id                String   @id @default(cuid())
    schoolId          String
    nationalHolidayId String
    observed          Boolean?
    decidedByUserId   String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    nationalHoliday NationalHoliday @relation(fields: [nationalHolidayId], references: [id], onDelete: Cascade)

    @@unique([schoolId, nationalHolidayId])
}

// ---------------------------------------------------------------------------
// School onboarding - predates or defines the tenant
// ---------------------------------------------------------------------------

/// A request to found a school, verified by hand by a platform admin.
///
/// ktpStoragePath is nulled and the file deleted the moment a decision is made,
/// approve or reject (UU PDP 27/2022). Only ktpVerifiedAt and the reviewer
/// survive as evidence the check happened.
model SchoolRegistration {
    id              String             @id @default(cuid())
    applicantUserId String
    npsn            String
    schoolName      String
    schoolType      SchoolType
    /// Carried to School.durationYears on approval. Only an SMK may choose (3 or 4);
    /// every other type takes its default from shared/schoolType.js.
    durationYears   Int?
    city            String?
    /// The school's point, carried to School on approval (teaching-and-learning
    /// ticket 01). Required of new registrations; null on ones filed before it.
    latitude        Float?
    longitude       Float?
    /// Carried to School on approval (teaching-and-learning ticket 07).
    timeZone        SchoolTimeZone?
    applicantPhone  String?
    ktpStoragePath  String?
    status          RegistrationStatus @default(PENDING)
    ktpVerifiedAt   DateTime?
    reviewedByAdminId String?
    reviewedAt      DateTime?
    rejectionReason String?
    createdSchoolId String?            @unique
    createdAt       DateTime           @default(now())
    updatedAt       DateTime           @updatedAt

    applicant     User           @relation("RegistrationApplicant", fields: [applicantUserId], references: [id])
    reviewedBy    PlatformAdmin? @relation("RegistrationReviewer", fields: [reviewedByAdminId], references: [id])
    createdSchool School?        @relation(fields: [createdSchoolId], references: [id])

    @@index([status])
    @@index([applicantUserId])
}

/// The tenancy boundary. Cannot be filtered by schoolId because it defines it.
model School {
    id            String     @id @default(cuid())
    npsn          String     @unique
    name          String
    schoolType    SchoolType
    /// 3 for most schools, 6 for SD, 4 for a four-year SMK. Drives the top grade.
    durationYears Int
    city          String?
    /// Where the school is, for a student's check-in (teaching-and-learning ticket
    /// 01): compared with the device's location against a fixed 150 m radius. Null
    /// until set - self check-in is then unavailable. The Principal may correct it.
    latitude      Float?
    longitude     Float?
    /// The zone its schedule is written in (teaching-and-learning ticket 07). Null
    /// for a school founded before it; a schedule needs one.
    timeZone      SchoolTimeZone?
    /// Whether this school takes joint leave (cuti bersama) off, the Principal's
    /// choice - regional education calendars differ (teaching-and-learning 08).
    observesJointLeave Boolean @default(true)
    /// The printed Report Card's letterhead (grading-and-report-card 10), set by the
    /// Principal: free text, null for none. The logo is a stored JPG or PNG, a new
    /// file at each upload and never written over, since a closed Report Card keeps
    /// the one it was closed with.
    address        String?
    phone          String?
    logoStorageKey String?
    /// Opaque, regenerable. Locates a school; grants nothing (ADR-0002).
    schoolCode    String     @unique
    /// The School's label under the platform's base domain (governing-body ticket 02,
    /// K9): `smapenabur1` for smapenabur1.<base>. It names the Place a sign-in is
    /// for and grants nothing - joining still takes the School Code (K16). Given at
    /// creation by the K9 rule (src/shared/subdomain.js), it does not follow a rename;
    /// only a Platform Admin changes it. Only the label is stored: the base domain is
    /// the frontend's configuration.
    subdomain     String     @unique
    /// The Governing Body above it, null for an independent School (governing-body
    /// ticket 03; set from ticket 05, when a body creates its Schools).
    governingBodyId String?
    // Access withdrawn by a platform admin, with the data left where it is.
    //
    // Deactivation is never a delete: School has thirteen cascading relations, so
    // removing the row would take the academic history with it - including the
    // ApprovalAudit rows that record the decision. A year of somebody's grades is
    // not one button's to erase.
    //
    // While this is set: buildAuthClaims() issues no school claims, so every
    // member's token carries no school and no tenant-owned row is reachable; the
    // School Code stops resolving. Nothing about the memberships themselves
    // changes - that is leaving, which is ADR-0004 and ticket 06.
    deactivatedAt        DateTime?
    deactivationReason   String?
    deactivatedByAdminId String?
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt

    deactivatedBy  PlatformAdmin?      @relation("SchoolDeactivatedBy", fields: [deactivatedByAdminId], references: [id])
    governingBody  GoverningBody?      @relation(fields: [governingBodyId], references: [id], onDelete: SetNull)
    registration   SchoolRegistration?
    memberships    SchoolMembership[]
    membershipRoles MembershipRole[]
    studentProfiles StudentProfile[]
    teacherProfiles TeacherProfile[]
    guardianLinks  GuardianStudent[]
    joinRequests   JoinRequestDetail[]
    academicYears  AcademicYear[]
    semesters      Semester[]
    subjects       Subject[]
    classes        Class[]
    classMemberships ClassMembership[]
    classSubjects  ClassSubject[]
    classMoves       ClassMove[]
    leaveRequests    LeaveRequest[]
    notifications  Notification[]
    approvalAudits ApprovalAudit[]
    schoolHolidays SchoolHoliday[]
    examWeeks      ExamWeek[]
    jointLeaveChoices SchoolJointLeaveChoice[]
    subjectChoices    SchoolSubjectChoice[]
    scheduleSlots  ClassSubjectSchedule[]
    sessions       Session[]
    attendances       Attendance[]
    attendanceChanges AttendanceChange[]
    contents          Content[]
    learningEvents    LearningEvent[]
    contentProgress   ContentProgress[]
    questions         Question[]
    questionImages    QuestionImage[]
    assessments       Assessment[]
    assessmentQuestions AssessmentQuestion[]
    submissions       Submission[]
    submissionAnswers SubmissionAnswer[]
    submissionAnswerOptions SubmissionAnswerOption[]
    scores            Score[]
    assessmentExceptions AssessmentException[]
    gradeSetting      SchoolGradeSetting?
    slotGradeSettings SlotGradeSetting[]
    slotDescriptions  SlotDescription[]
    homeroomNotes     HomeroomNote[]
    slotFinalisations SlotFinalisation[]
    reportCards       ReportCard[]
    reportCardSubjects ReportCardSubject[]
    refreshTokens     RefreshToken[]
    handoffCodes      HandoffCode[]

    @@index([deactivatedAt])
}

// ---------------------------------------------------------------------------
// Membership - the tenant boundary for people
// ---------------------------------------------------------------------------

/// A User's affiliation with one School.
///
/// At most ONE row per user per School may be PENDING or ACTIVE, at any number of
/// Schools (governing-body ticket 01, ADR-0011). That is a partial unique index in
/// migration SQL, not @@unique - REJECTED and LEFT rows must repeat, or nobody
/// could ever be rejected twice or come back. A Student holds one live membership
/// on the whole platform; that is a rule of the services (membership.eligibility.js),
/// since it spans rows no index can relate.
model SchoolMembership {
    id          String           @id @default(cuid())
    schoolId    String
    userId      String
    status      MembershipStatus @default(PENDING)
    requestedAt DateTime         @default(now())
    approvedAt  DateTime?
    endedAt     DateTime?
    /// Why a LEFT membership ended: a removal's reason, the reason an approved
    /// LeaveRequest gave (ticket 17), or the automatic one when a guardian's last
    /// linked student leaves (ticket 06). Null for a guardian's plain leave.
    endReason   String?
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    user            User              @relation(fields: [userId], references: [id])
    roles           MembershipRole[]
    studentProfile  StudentProfile?
    teacherProfile  TeacherProfile?
    joinRequest     JoinRequestDetail?
    guardianLinks   GuardianStudent[] @relation("GuardianMembership")
    homeroomClasses Class[]           @relation("HomeroomTeacher")
    taughtSubjects  ClassSubject[]    @relation("AssignedTeacher")
    leaveRequests   LeaveRequest[]
    notifications   Notification[]
    learningEvents  LearningEvent[]
    questions       Question[]
    questionImages  QuestionImage[]

    // No @@unique([schoolId, userId]). Dropped on 2026-09-20 (owner), because a
    // TOTAL constraint here contradicts decision #51: a rejected applicant may
    // re-apply after a cooldown, and assertMembershipRetryAllowed() counts their
    // REJECTED rows against a cap of three - a count that can never pass one if
    // only one row per (school, user) may exist. Leaving and later rejoining the
    // same school (ticket 06) needs the repeats too.
    //
    // The real rule is the partial index in partial-indexes.sql: one
    // PENDING-or-ACTIVE membership per user per school (governing-body ticket 01;
    // until then, one across every school).
    @@index([schoolId, status])
    @@index([userId])
}

/// One role within a membership, approved on its own.
///
/// STUDENT is exclusive - it may not coexist with any other role. That rule is
/// enforced in the approval service, not here: expressing "this enum value
/// excludes all others for the same parent" is not something a schema can say.
model MembershipRole {
    id               String         @id @default(cuid())
    schoolId         String
    membershipId     String
    role             SchoolRole
    status           ApprovalStatus @default(PENDING)
    approvedByUserId String?
    approvedAt       DateTime?
    rejectionReason  String?
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt

    school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

    @@unique([membershipId, role])
    @@index([schoolId, role, status])
}

/// NISN is unique PER SCHOOL, never globally (ADR-0004). The same child
/// legitimately has a row at each school they have attended.
///
/// Unique among LIVE profiles only (owner, 2026-09-26): a student who left and
/// comes back to the same school gets a new profile beside the ended one, which
/// stays with its LEFT membership as history. A partial unique index in migration
/// SQL, not @@unique.
model StudentProfile {
    id           String    @id @default(cuid())
    schoolId     String
    membershipId String    @unique
    nisn         String
    birthDate    DateTime?
    /// Set with the membership's endedAt when it ends (endMembership).
    endedAt      DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    membership       SchoolMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    classMemberships ClassMembership[]
    classMoves       ClassMove[]
    guardianLinks    GuardianStudent[]
    attendances      Attendance[]
    contentProgress  ContentProgress[]
    submissions      Submission[]
    assessmentExceptions AssessmentException[]
    slotDescriptions SlotDescription[]
    homeroomNotes    HomeroomNote[]
    reportCards      ReportCard[]

    @@index([schoolId])
}

/// NIP and NUPTK are unique among live profiles only, for the same reason as a
/// student's NISN - partial unique indexes in migration SQL.
model TeacherProfile {
    id           String    @id @default(cuid())
    schoolId     String
    membershipId String    @unique
    nip          String?
    nuptk        String?
    /// Set with the membership's endedAt when it ends (endMembership).
    endedAt      DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

    @@index([schoolId])
}

/// Guardian access derives from this link, not from holding the GUARDIAN role.
/// A teacher whose own child attends the same school holds TEACHER + GUARDIAN on
/// one membership and reaches their child through here.
model GuardianStudent {
    id                   String         @id @default(cuid())
    schoolId             String
    guardianMembershipId String
    studentProfileId     String
    relationship         String
    status               ApprovalStatus @default(PENDING)
    approvedByUserId     String?
    approvedAt           DateTime?
    /// A link can be refused on its own - a guardian claiming a further child -
    /// with no role row to carry the reason.
    rejectionReason      String?
    endedAt              DateTime?
    createdAt            DateTime       @default(now())
    updatedAt            DateTime       @updatedAt

    school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    guardianMembership SchoolMembership @relation("GuardianMembership", fields: [guardianMembershipId], references: [id], onDelete: Cascade)
    studentProfile    StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

    @@unique([guardianMembershipId, studentProfileId])
    @@index([schoolId, status])
    @@index([studentProfileId])
}

/// What a join applicant typed, parked until approval turns it into a real
/// profile. StudentProfile and TeacherProfile are only created once a human
/// releases the role, so until then the payload has nowhere else to live - the
/// same gap SchoolRegistration.durationYears fills for school founding.
///
/// Deliberately NOT the profile tables themselves: StudentProfile is unique on
/// (schoolId, nisn), so a stranger filing a request would reserve a real child's
/// NISN - and rejected rows are never deleted, so the reservation would be
/// permanent.
///
/// No class is named here. The applicant asks for a gradeLevel; the homeroom
/// teacher chooses the class at approval, which is why a leaked School Code
/// exposes no class list (ADR-0002, ticket 05).
model JoinRequestDetail {
    id           String    @id @default(cuid())
    schoolId     String
    membershipId String    @unique
    /// STUDENT
    nisn         String?
    birthDate    DateTime?
    gradeLevel   Int?
    /// TEACHER - at least one of the two, checked by the zod schema.
    nip          String?
    nuptk        String?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt

    school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

    @@index([schoolId, gradeLevel])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model AcademicYear {
    id        String             @id @default(cuid())
    schoolId  String
    /// Format "2026/2027", constrained so cross-school reporting can align.
    label     String
    startDate DateTime
    endDate   DateTime
    status    AcademicYearStatus @default(ACTIVE)
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt

    school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    semesters Semester[]
    classes   Class[]

    @@unique([schoolId, label])
    @@index([schoolId, status])
}

model Semester {
    id             String         @id @default(cuid())
    schoolId       String
    academicYearId String
    /// 1 or 2.
    ordinal        Int
    startDate      DateTime
    endDate        DateTime
    status         SemesterStatus @default(OPEN)
    /// Past this, only a principal override creates a ClassSubject.
    classSubjectRegistrationDeadline DateTime?
    closedByUserId String?
    closedAt       DateTime?
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    classSubjects ClassSubject[]
    slotGradeSettings SlotGradeSetting[]
    slotDescriptions SlotDescription[]
    homeroomNotes    HomeroomNote[]
    slotFinalisations SlotFinalisation[]
    examWeeks        ExamWeek[]
    reportCards      ReportCard[]

    @@unique([academicYearId, ordinal])
    @@index([schoolId, status])
}

/// Nullable tenant: schoolId NULL is the national catalog shared by every
/// school; a schoolId means one school's local subject (muatan lokal).
/// The tenant extension reads these as `schoolId IS NULL OR schoolId = current`.
model Subject {
    id        String   @id @default(cuid())
    schoolId  String?
    code      String
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    school        School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    classSubjects ClassSubject[]
    schoolChoices SchoolSubjectChoice[]
    questions     Question[]
    slotGradeSettings SlotGradeSetting[]
    slotDescriptions SlotDescription[]
    slotFinalisations SlotFinalisation[]
    reportCardSubjects ReportCardSubject[]

    @@unique([schoolId, code])
    @@index([schoolId])
}

/// Whether a school uses one national Subject (registration-and-membership 20,
/// owner 2026-10-04). A school with no row uses it, so every school - and every
/// national Subject added later - starts with all of them, and nothing is backfilled.
/// `selected` false takes the Subject out of reach for new ClassSubjects; true puts
/// it back, so selecting it again needs no delete. Set by the Principal or a Vice
/// Principal, for national Subjects only: a local one is the school's own.
model SchoolSubjectChoice {
    id              String   @id @default(cuid())
    schoolId        String
    subjectId       String
    selected        Boolean
    decidedByUserId String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

    @@unique([schoolId, subjectId])
}

/// A cohort, never a course offering. Created by the principal, who names its
/// homeroom teacher in the same action - a homeroom teacher cannot create the
/// class they are about to be designated on.
model Class {
    id                          String   @id @default(cuid())
    schoolId                    String
    academicYearId              String
    name                        String
    gradeLevel                  Int
    homeroomTeacherMembershipId String?
    createdByUserId             String
    createdAt                   DateTime @default(now())
    updatedAt                   DateTime @updatedAt

    school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    homeroomTeacher SchoolMembership? @relation("HomeroomTeacher", fields: [homeroomTeacherMembershipId], references: [id])
    memberships     ClassMembership[]
    classSubjects   ClassSubject[]
    movesOut        ClassMove[]       @relation("ClassMoveFrom")
    movesIn         ClassMove[]       @relation("ClassMoveTo")
    slotGradeSettings SlotGradeSetting[]
    slotDescriptions SlotDescription[]
    slotFinalisations SlotFinalisation[]
    reportCards      ReportCard[]
    reportCardSubjects ReportCardSubject[]

    @@unique([schoolId, academicYearId, name])
    @@index([schoolId, gradeLevel])
    @@index([homeroomTeacherMembershipId])
}

/// A student's placement in a class. Created by placement or rollover, never by
/// the student. Promotion writes a NEW row and never mutates the old one, so
/// past report cards keep their class context forever.
model ClassMembership {
    id               String            @id @default(cuid())
    schoolId         String
    classId          String
    studentProfileId String
    startedAt        DateTime          @default(now())
    endedAt          DateTime?
    /// The Homeroom Teacher's own Promotion Outcome for the year, on the open placement
    /// (grading-and-report-card ticket 09). Null leaves it to the automatic one, which
    /// the even Semester's close freezes onto the Report Card with the rest.
    outcome          PromotionOutcome?
    outcomeSetByUserId String?
    outcomeSetAt     DateTime?
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt

    school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

    @@index([schoolId, classId])
    @@index([studentProfileId, endedAt])
}

/// One subject taught to one class in one semester by one teacher. The
/// structural spine: content, sessions, assessments and grades will hang here.
///
/// Teachers self-assign; the principal approves. At most one PENDING-or-ACTIVE
/// row per class+subject+semester, enforced by a partial unique index so a
/// rejected request never permanently blocks the slot.
model ClassSubject {
    id                  String         @id @default(cuid())
    schoolId            String
    classId             String
    subjectId           String
    semesterId          String
    teacherMembershipId String
    status              ApprovalStatus @default(PENDING)
    requestedAt         DateTime       @default(now())
    decidedByUserId     String?
    decidedAt           DateTime?
    rejectionReason     String?
    /// True when a principal created this after the registration deadline.
    createdViaOverride  Boolean        @default(false)
    /// Set when the teacher leaves the school (ticket 08), or when the Principal or a
    /// Vice Principal ends or replaces the assignment (teaching-and-learning 10): the
    /// row stays as history, and the partial unique index frees the slot.
    endedAt             DateTime?
    /// Why it was ended or replaced (t&l 10), shown to its teacher. Null when the
    /// teacher left the school.
    endReason           String?
    createdAt           DateTime       @default(now())
    updatedAt           DateTime       @updatedAt

    school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
    subject  Subject          @relation(fields: [subjectId], references: [id])
    semester Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
    teacher  SchoolMembership @relation("AssignedTeacher", fields: [teacherMembershipId], references: [id])
    scheduleSlots ClassSubjectSchedule[]
    sessions      Session[]
    assessments   Assessment[]

    @@index([schoolId, status])
    @@index([teacherMembershipId, status])
    @@index([classId, semesterId])
}

enum SessionStatus {
    SCHEDULED
    CANCELLED
}

enum SessionCancelReason {
    /// A holiday that started counting after the Semester had started.
    HOLIDAY
    /// A number the schedule no longer reaches, after a change to the timetable, the
    /// Semester's dates or the school's time zone.
    SCHEDULE_CHANGED
    /// A Session created in the past that its teacher says never took place
    /// (teaching-and-learning ticket 09).
    NOT_HELD
    /// Its teaching assignment was ended and the subject stops in that Class
    /// (teaching-and-learning ticket 10).
    ASSIGNMENT_ENDED
    /// An Exam Week of its Class's grade level that started counting after the
    /// Semester had started (teaching-and-learning ticket 13). A day both a holiday and
    /// an Exam Week is a holiday (owner, 2026-10-18).
    EXAM_WEEK
}

/// One weekly slot of a ClassSubject's timetable (teaching-and-learning ticket 02):
/// a day and a time in the SCHOOL's own zone (School.timeZone), set by the Principal
/// or a Vice Principal. A schedule is replaced whole; the old slots are stamped
/// replacedAt and kept, never deleted.
model ClassSubjectSchedule {
    id             String    @id @default(cuid())
    schoolId       String
    classSubjectId String
    /// ISO: 1 Monday ... 7 Sunday.
    dayOfWeek      Int
    /// Minutes after local midnight, so an overlap is plain arithmetic.
    startMinute    Int
    endMinute      Int
    replacedAt     DateTime?
    createdAt      DateTime  @default(now())

    school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

    @@index([classSubjectId, replacedAt])
}

/// One meeting of a ClassSubject - "Pertemuan ke-N" (CONTEXT.md; handoff #10).
/// Generated from the schedule across the Semester, skipping holidays. Never deleted:
/// a number the schedule no longer reaches, or a day that became a holiday after
/// the start, is CANCELLED. Past Sessions stay with the ClassSubject that taught them;
/// a successor teacher's ClassSubject takes over the future ones.
///
/// A Session created already in the past - a first timetable set after the start, or a
/// start date moved back - needs completion (ticket 09): its teacher answers that it
/// happened (completedAt) or that it never did (CANCELLED, NOT_HELD).
model Session {
    id              String               @id @default(cuid())
    schoolId        String
    classSubjectId  String
    number          Int
    startsAt        DateTime
    endsAt          DateTime
    status          SessionStatus        @default(SCHEDULED)
    cancelReason    SessionCancelReason?
    cancelledAt     DateTime?
    /// Created before tomorrow, after the fact; waits for its teacher's answer.
    needsCompletion Boolean              @default(false)
    /// When its teacher confirmed its attendance (teaching-and-learning 03): the
    /// meeting happened. Counts as a meeting that happened, like a check-in does.
    completedAt       DateTime?
    completedByUserId String?
    topic           String?
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt

    school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
    attendances  Attendance[]
    contents     Content[]

    @@unique([classSubjectId, number])
    @@index([schoolId, startsAt])
    @@index([classSubjectId, startsAt])
}

enum AttendanceStatus {
    /// Hadir
    PRESENT
    /// Sakit
    SICK
    /// Izin
    EXCUSED
    /// Alpa
    ABSENT
}

/// One student at one Session (teaching-and-learning 03). Made by the student's
/// check-in, or by the teacher's confirmation for everyone who did not check in.
/// The device's location decides the two flags and is never stored - no
/// coordinates, no distance (UU PDP Pasal 16, 25).
model Attendance {
    id               String           @id @default(cuid())
    schoolId         String
    sessionId        String
    studentProfileId String
    status           AttendanceStatus
    checkedInAt      DateTime?
    /// Checked in farther than 150 m from the school's point.
    outsideSchool    Boolean          @default(false)
    /// Checked in more than 30 minutes after the Session started.
    late             Boolean          @default(false)
    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt

    school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    session        Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
    changes        AttendanceChange[]

    @@unique([sessionId, studentProfileId])
    @@index([schoolId, sessionId])
    @@index([studentProfileId])
}

/// A teacher's change to an Attendance status, at confirmation or after it
/// (teaching-and-learning 03). Append-only: written, never updated or deleted.
model AttendanceChange {
    id              String           @id @default(cuid())
    schoolId        String
    attendanceId    String
    fromStatus      AttendanceStatus
    toStatus        AttendanceStatus
    note            String?
    changedByUserId String
    createdAt       DateTime         @default(now())

    school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

    @@index([attendanceId, createdAt])
    @@index([schoolId])
}

enum ContentType {
    /// Uploaded: PDF, JPG, PNG, DOCX or PPTX, at most 10 MB.
    FILE
    /// A link only, never uploaded: YouTube, or another https page.
    VIDEO
    /// Rich text, sanitised before it is stored.
    TEXT
    LINK
}

/// A piece of learning material under a Session (teaching-and-learning 04,
/// handoff #13). No prerequisite gating. Students see it once its teacher
/// publishes it. Soft-deleted only (handoff #26).
///
/// payload per type - FILE { storageKey, fileName, fileType, mimeType, size },
/// VIDEO { url, provider, videoId }, TEXT { html }, LINK { url }. A FILE's
/// storageKey never leaves the server.
model Content {
    id              String      @id @default(cuid())
    schoolId        String
    sessionId       String
    type            ContentType
    title           String
    order           Int
    payload         Json
    publishedAt     DateTime?
    deletedAt       DateTime?
    createdByUserId String
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt

    school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    session  Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    progress ContentProgress[]

    @@index([sessionId, order])
    @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Tracking - teaching-and-learning 05, the thesis's contribution (handoff #11)
// ---------------------------------------------------------------------------

/// Something a person did: actor, verb, object, context, time. The source of truth
/// for progress, and later for gamification and support signals.
///
/// Append-only (handoff #26). No code path updates or deletes one, and the
/// database refuses it too: a trigger in the _add_learning_events migration
/// raises on every UPDATE, and on every DELETE unless the transaction has set
/// lms.allow_learning_event_delete - which only the test-data cleanup does. A
/// school or membership deleted by hand therefore fails on its events.
///
/// verb is from a closed list in src/modules/tracking/tracking.record.js, a String
/// so the assessment slice adds its own without an enum migration. objectType names
/// the table objectId points into (Content, Session). occurredAt is when it
/// happened, bounded by the server for what a client reports; receivedAt is when
/// the server wrote it.
model LearningEvent {
    id                String   @id @default(cuid())
    schoolId          String
    actorMembershipId String
    verb              String
    objectType        String
    objectId          String
    context           Json
    occurredAt        DateTime
    receivedAt        DateTime @default(now())

    school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    actor  SchoolMembership @relation(fields: [actorMembershipId], references: [id], onDelete: Cascade)

    @@index([schoolId, actorMembershipId, occurredAt])
    @@index([objectType, objectId])
}

/// One student's progress through one Content, derived from their Learning Events
/// in the same transaction (handoff #24) - never written on its own. Completion is
/// per type (owner, 2026-09-27): a FILE opened or downloaded, a YouTube VIDEO
/// watched to 80%, a TEXT read to its end, a LINK (or another site's VIDEO)
/// clicked. Client-reported, so a signal, not proof (handoff #15).
model ContentProgress {
    id                   String    @id @default(cuid())
    schoolId             String
    contentId            String
    studentProfileId     String
    firstOpenedAt        DateTime?
    lastActivityAt       DateTime
    /// Set once, by the event that completed it, and never cleared.
    completedAt          DateTime?
    /// The furthest point of a VIDEO reached, as recorded per 10% (tracking.record.js).
    videoPositionSeconds Float?
    videoDurationSeconds Float?
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    content        Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

    @@unique([contentId, studentProfileId])
    @@index([schoolId])
    @@index([studentProfileId])
}

// ---------------------------------------------------------------------------
// Assessment - the question bank (assessment ticket 01)
// ---------------------------------------------------------------------------

enum QuestionKind {
    /// Multiple choice, 2 to 6 options, scored as its McqScoring says.
    MCQ
    /// True or false.
    TF
    /// A short answer, marked against a list of accepted answers.
    SHORT
    /// Marked by hand. The answer is text, a file, or both (ticket 03).
    ESSAY
}

/// How an MCQ is scored, the teacher's choice per question (owner, 2026-10-04).
/// Ticket 03 computes it.
enum McqScoring {
    /// Exactly one option is correct.
    SINGLE
    /// One or more are correct; the points come only when the chosen set is exactly right.
    ALL_OR_NOTHING
    /// One or more are correct; (correct chosen - wrong chosen) / correct x points,
    /// never below 0.
    PARTIAL
}

/// A question in the School's bank, kept per Subject x Grade Level (assessment
/// ticket 01). Only its author edits it. A teacher teaching that Subject at that
/// Grade Level now sees it, and the Principal and Vice Principals read all of it.
/// Archived, never deleted. An Assessment holds a copy of it (ticket 02), so no
/// change here reaches one.
///
/// Two JSON columns, so the key never sits in the JSON a Student may one day be
/// shown (owner, 2026-10-05). Both carry `v`, the version of their shape:
/// - payload: { v, body, imageId, options: [{ id, text, imageId }] } - options
///   for an MCQ only;
/// - answerKey: MCQ { v, correctOptionIds }, TF { v, value }, SHORT { v, accepted },
///   null for an ESSAY.
/// An imageId names a QuestionImage. An option's id is minted by the server and
/// kept by every edit that keeps the option.
///
/// Private until privateUntil (owner, 2026-10-07): up to that day, the school's own
/// date, included, only its author and the leaders see it; an Assessment holding it
/// stays closed to the other teachers who could copy it (ticket 02).
model Question {
    id                 String       @id @default(cuid())
    schoolId           String
    subjectId          String
    gradeLevel         Int
    kind               QuestionKind
    /// An MCQ's only.
    mcqScoring         McqScoring?
    payload            Json
    answerKey          Json?
    authorMembershipId String
    /// The question this one is a duplicate of.
    duplicatedFromId   String?
    archivedAt         DateTime?
    /// A day at midnight UTC, at most a year ahead when set. NULL is never private.
    privateUntil       DateTime?
    createdAt          DateTime     @default(now())
    updatedAt          DateTime     @updatedAt

    school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    subject        Subject          @relation(fields: [subjectId], references: [id])
    author         SchoolMembership @relation(fields: [authorMembershipId], references: [id])
    duplicatedFrom Question?        @relation("QuestionDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
    duplicates     Question[]       @relation("QuestionDuplicate")
    snapshots      AssessmentQuestion[]

    @@index([schoolId, subjectId, gradeLevel])
    @@index([authorMembershipId])
}

/// An image for a question or one of its options (assessment ticket 01): JPG or
/// PNG, typed by its bytes, at most 5 MB. Uploaded before the question is saved,
/// which then names it by id (owner, 2026-10-05). Never deleted: a duplicate shares
/// it, and so will an Assessment's copy. The storage key never leaves the server.
model QuestionImage {
    id                     String   @id @default(cuid())
    schoolId               String
    storageKey             String
    mimeType               String
    size                   Int
    uploadedByMembershipId String
    createdAt              DateTime @default(now())

    school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    uploadedBy SchoolMembership @relation(fields: [uploadedByMembershipId], references: [id])

    @@index([schoolId])
    @@index([uploadedByMembershipId])
}

// ---------------------------------------------------------------------------
// Assessment - Assessments and their questions (assessment ticket 02)
// ---------------------------------------------------------------------------

/// A label the grading slice weights (owner, 2026-10-04).
enum AssessmentType {
    TUGAS
    KUIS
    UTS
    UAS
    /// Practice, never graded (assessment ticket 08, owner 2026-10-18): ONLINE only, no
    /// Score, its result shown at hand-in, left out of the grades and the Report Card.
    LATIHAN
}

enum AssessmentMode {
    /// Questions, answered in the app (ticket 03).
    ONLINE
    /// No questions and no Submission: the teacher enters a 0-100 mark per Student
    /// (ticket 04) - a paper exam, an oral test, a practical.
    OFFLINE
}

/// One Assessment on a ClassSubject (assessment ticket 02, owner 2026-10-04). Managed
/// by the ClassSubject's Answering Teacher - the successor once it ended - and read by
/// the Class's homeroom teacher, the Principal and the Vice Principals, who change
/// nothing. It has its own window, inside the Semester, and is not tied to a Session.
///
/// A draft until publishedAt. A draft may be deleted (deletedAt); a published one
/// never is: it is cancelled, with a reason its Students see, and nothing changes in
/// it afterwards. The settings are an ONLINE one's; an OFFLINE one keeps their
/// defaults and uses none of them.
model Assessment {
    id                String         @id @default(cuid())
    schoolId          String
    classSubjectId    String
    type              AssessmentType
    mode              AssessmentMode
    title             String
    /// HTML, sanitised as a question's body is.
    instructions      String?
    opensAt           DateTime
    closesAt          DateTime
    /// Null is unlimited, on a LATIHAN only (assessment ticket 08, owner 2026-10-18).
    maxAttempts       Int?           @default(1)
    acceptLate        Boolean        @default(false)
    timeLimitMinutes  Int?
    shuffleQuestions  Boolean        @default(false)
    shuffleOptions    Boolean        @default(false)
    /// Whether the answer key is shown with the Score at release (ticket 04).
    showKeyOnRelease  Boolean        @default(false)
    publishedAt       DateTime?
    /// When a release first recorded a Score (ticket 04). From then its questions
    /// are locked: only a key or points may be fixed, as Score corrections.
    releasedAt        DateTime?
    cancelledAt       DateTime?
    cancelReason      String?
    cancelledByUserId String?
    /// Drafts only.
    deletedAt         DateTime?
    createdByUserId   String
    /// The Assessment this one was copied from, into another Class.
    copiedFromId      String?
    createdAt         DateTime       @default(now())
    updatedAt         DateTime       @updatedAt

    school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    classSubject ClassSubject         @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
    copiedFrom   Assessment?          @relation("AssessmentCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
    copies       Assessment[]         @relation("AssessmentCopy")
    questions    AssessmentQuestion[]
    submissions  Submission[]
    exceptions   AssessmentException[]

    @@index([schoolId])
    @@index([classSubjectId])
}

/// A question as an Assessment holds it: a copy of a bank Question, made when it was
/// put in (assessment ticket 02). No change to the bank reaches it, and nothing reads
/// the bank at answer or marking time - that is what makes a Score reproducible.
///
/// The shape is the bank's (owner, 2026-10-05): kind, mcqScoring, and copies of
/// payload and answerKey, each with its `v`. Option ids are copied as they are, and
/// ticket 03's answers point at them. Images are shared by imageId.
///
/// answerKey is left out of every read by a global omit in src/shared/prisma.js;
/// only the staff's reads, marking and the released key ask for it. Removed softly
/// (removedAt), since a Submission's answers will point here (ticket 03).
model AssessmentQuestion {
    id               String       @id @default(cuid())
    schoolId         String
    assessmentId     String
    order            Int
    /// Whole points, 1 to 100 (owner, 2026-10-07).
    points           Int
    /// The bank question it was copied from, for history only.
    sourceQuestionId String?
    kind             QuestionKind
    mcqScoring       McqScoring?
    payload          Json
    answerKey        Json?
    removedAt        DateTime?
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt

    school         School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
    sourceQuestion Question?  @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
    answers        SubmissionAnswer[]
    chosenOptions  SubmissionAnswerOption[]

    @@index([assessmentId, order])
    @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Assessment - Submissions (assessment ticket 03)
// ---------------------------------------------------------------------------

/// How a Submission closed (assessment ticket 03).
enum SubmissionClose {
    /// The Student handed it in.
    STUDENT
    /// Its deadline passed. Closed the first time anything touched it after that,
    /// with the deadline as its submittedAt (owner, 2026-10-08).
    TIME
    /// An OFFLINE Assessment's mark, entered by its teacher (ticket 04, owner
    /// 2026-10-09): a Submission without answers, closed as it is made.
    TEACHER
}

/// One Student's attempt at an ONLINE Assessment (assessment ticket 03): started,
/// answered question by question, then closed - handed in, or by time. Never
/// deleted: a change to a question under it voids it (voidedAt, voidReason), and a
/// void one does not count toward maxAttempts.
///
/// At most one in progress - submittedAt and voidedAt both null - per Student and
/// Assessment: a partial unique index in migration SQL.
///
/// shownOrder is what the Student was shown, drawn once at the start (owner,
/// 2026-10-08): { v, questions: [AssessmentQuestion id], options: { [AssessmentQuestion
/// id]: [option id] } }. Shuffled when the Assessment says so, and kept either way, so
/// neither a reload nor the teacher reordering the list moves anything.
model Submission {
    id               String           @id @default(cuid())
    schoolId         String
    assessmentId     String
    studentProfileId String
    /// 1, 2, ... per Student and Assessment, void ones included. An OFFLINE
    /// original is 1; its remedial mark the next after the highest, at least 2.
    attempt          Int
    startedAt        DateTime
    /// The time limit after startedAt, capped by the hard end - closesAt, or the
    /// Semester's end with acceptLate; the hard end alone with no time limit.
    deadlineAt       DateTime
    submittedAt      DateTime?
    closedBy         SubmissionClose?
    /// Closed after the Assessment's closesAt, which acceptLate allows.
    late             Boolean          @default(false)
    /// Started under a remedial Assessment Exception (ticket 05's follow-up, owner
    /// 2026-10-11), copied from it at the start: a later change to the exception
    /// leaves this attempt as it was. Or an OFFLINE remedial mark, entered beside
    /// the original (assessment ticket 09, owner 2026-10-18). The grading slice
    /// applies the school's remedial rule (a KKTP cap, the highest, or an average)
    /// to these.
    remedial         Boolean          @default(false)
    voidedAt         DateTime?
    voidReason       String?
    shownOrder       Json
    /// An OFFLINE Assessment's mark, 0-100, entered by its teacher (ticket 04): a
    /// draft until release, then a Score. Null on an ONLINE one's.
    offlineMark      Decimal?         @db.Decimal(5, 2)
    /// The teacher's comment on the whole Submission (ticket 04), shown at release.
    comment          String?
    /// When a release recorded its first Score (ticket 04). Claimed, so a release
    /// pressed twice at once records no Score twice.
    releasedAt       DateTime?
    /// The integrity signals its frontend reported while it was in progress
    /// (assessment ticket 06): focus lost, a paste, a copy, fullscreen left. Counted on
    /// a KUIS, UTS or UAS answered ONLINE only, by tracking.record.js, in the same
    /// transaction as each signal's Learning Event (handoff #24). Advisory, for the
    /// staff alone (handoff #15): nothing is penalised on them, and no read of a
    /// Student's carries them.
    focusLostCount   Int              @default(0)
    pastedCount      Int              @default(0)
    copiedCount      Int              @default(0)
    fullscreenExitedCount Int         @default(0)
    createdAt        DateTime         @default(now())
    updatedAt        DateTime         @updatedAt

    school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    assessment     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
    answers        SubmissionAnswer[]
    scores         Score[]

    @@unique([assessmentId, studentProfileId, attempt])
    @@index([schoolId])
    @@index([studentProfileId])
}

/// A Submission's answer to one question (assessment ticket 03), saved as the Student
/// goes. An MCQ's chosen options are rows (SubmissionAnswerOption); a TF's is value; a
/// SHORT's is text; an ESSAY's is plain text - at most 20,000 characters, owner
/// 2026-10-08 - a file, or both. The file's storage key never leaves the server.
///
/// autoPoints is the automatic mark, a draft until release (ticket 04): written when
/// the Submission closes, and again when the key or the points change. Null for an
/// ESSAY, which the teacher marks.
model SubmissionAnswer {
    id                   String    @id @default(cuid())
    schoolId             String
    submissionId         String
    assessmentQuestionId String
    value                Boolean?
    text                 String?
    fileStorageKey       String?
    fileName             String?
    fileMimeType         String?
    fileSize             Int?
    autoPoints           Decimal?  @db.Decimal(7, 4)
    /// The teacher's points (ticket 04): an ESSAY's mark, or a SHORT's automatic
    /// one overridden - 0 to the question's points. Counts in place of autoPoints
    /// when set, and survives a key fix. A draft until release.
    teacherPoints        Decimal?  @db.Decimal(7, 4)
    /// The teacher's comment on this answer (ticket 04), shown at release.
    comment              String?
    savedAt              DateTime
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    submission         Submission               @relation(fields: [submissionId], references: [id], onDelete: Cascade)
    assessmentQuestion AssessmentQuestion       @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
    chosenOptions      SubmissionAnswerOption[]

    @@unique([submissionId, assessmentQuestionId])
    @@index([schoolId])
    @@index([assessmentQuestionId])
}

/// An option chosen in an MCQ answer, a row each (owner, 2026-10-05), so which is
/// chosen most stays one Prisma groupBy. optionId is the Assessment's copy's option,
/// never the bank's.
model SubmissionAnswerOption {
    id                   String @id @default(cuid())
    schoolId             String
    answerId             String
    assessmentQuestionId String
    optionId             String

    school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    answer             SubmissionAnswer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
    assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

    @@unique([answerId, optionId])
    @@index([assessmentQuestionId, optionId])
    @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Assessment - Scores (assessment ticket 04)
// ---------------------------------------------------------------------------

/// A Submission's mark as a release recorded it (assessment ticket 04): 0-100, the
/// points earned / the total of the questions it showed x 100, or an OFFLINE mark
/// as entered. What its Student sees, and what the grading slice will count.
///
/// Append-only (handoff #26, owner 2026-10-04): a correction is a new row with a
/// required reason, the old one stays, and the newest counts. Written only by
/// src/modules/assessment/assessment.score.js. The database refuses it too: a
/// trigger in the _add_scores migration raises on every UPDATE, and on every DELETE
/// unless the transaction has set lms.allow_score_delete - which only the test-data
/// cleanup does. A Submission, an Assessment or a school deleted by hand therefore
/// fails on its Scores.
///
/// The Score that counts for a Student on an Assessment is the highest of the
/// newest Scores of their released Submissions not void.
model Score {
    id               String   @id @default(cuid())
    schoolId         String
    submissionId     String
    /// 0-100, two decimals.
    value            Decimal  @db.Decimal(5, 2)
    /// An ONLINE Submission's points earned and total; null for an OFFLINE mark.
    pointsEarned     Decimal? @db.Decimal(9, 4)
    pointsTotal      Int?
    /// Null on the first Score of a Submission; required on every correction.
    reason           String?
    recordedAt       DateTime @default(now())
    recordedByUserId String

    school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

    @@index([submissionId, recordedAt])
    @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Assessment - make-up and remedial (assessment ticket 05)
// ---------------------------------------------------------------------------

/// One Student's exception on an ONLINE Assessment (assessment ticket 05, owner
/// 2026-10-04), set by its Answering Teacher for a Student placed in its Class now:
/// - a make-up (susulan): opensAt and closesAt, both or neither - the Student's own
///   window, inside the Semester, in place of the Class's (2026-10-10). Late is
///   counted from its closesAt, and with acceptLate runs to the Semester's end;
/// - extraAttempts, added to the Assessment's maxAttempts. The highest Score counts
///   (ticket 04), so a better result counts by itself;
/// - remedial (owner, 2026-10-11): whether the attempts started under it are a
///   remedial, copied to each Submission at its start. A remedial gives its
///   extraAttempts alone, at least one, counting only the remedial attempts, and only
///   once the Class's window has closed. A make-up for the sick, or extra attempts
///   after a lost connection, is not one.
///
/// One live row per Student and Assessment, changed in place (2026-10-10): a partial
/// unique index in migration SQL. It holds no mark, so the Score rule does not bind
/// it. Removed softly (removedAt), and only while the Student has started no
/// Submission since it was set.
model AssessmentException {
    id               String    @id @default(cuid())
    schoolId         String
    assessmentId     String
    studentProfileId String
    opensAt          DateTime?
    closesAt         DateTime?
    /// 0 to 20, added to maxAttempts.
    extraAttempts    Int       @default(0)
    remedial         Boolean   @default(false)
    /// Who set it, or changed it last.
    setByUserId      String
    removedAt        DateTime?
    removedByUserId  String?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

    @@index([schoolId])
    @@index([assessmentId])
    @@index([studentProfileId])
}

// ---------------------------------------------------------------------------
// Grading - settings (grading-and-report-card ticket 01)
// ---------------------------------------------------------------------------

/// How a remedial attempt's Score enters the Final Grade, per Assessment, for a
/// Student whose remedial attempts beat their ordinary ones (owner, 2026-10-13). The
/// Score itself stays raw: the rule is applied where the grade is computed.
enum RemedialRule {
    /// max(original, min(remedial, KKTP)). The default for a school that never chose.
    CAP_AT_KKTP
    /// The higher of the two, the Score that counts as it is.
    HIGHEST
    /// (original + remedial) / 2, or the remedial alone when there is no original.
    AVERAGE
}

/// The school's own grade settings (grading-and-report-card 01, owner 2026-10-13),
/// set by the Principal or a Vice Principal. At most one row per school, written
/// the first time one of them saves. A null value, and a school with no row, mean the
/// built-in default: 25/25/25/25, KKTP 75, the cap - read as "not set by the school".
/// A change is audited UPDATE_GRADE_SETTINGS, against the school.
model SchoolGradeSetting {
    id           String        @id @default(cuid())
    schoolId     String        @unique
    /// The Grade Weights of TUGAS, KUIS, UTS and UAS: whole numbers summing to 100,
    /// all four set or all four null.
    weightTugas  Int?
    weightKuis   Int?
    weightUts    Int?
    weightUas    Int?
    /// 0-100.
    kktp         Int?
    remedialRule RemedialRule?
    /// Whether the printed Report Card carries a blank Extracurricular table and a blank
    /// Personality table, to fill in by hand (ticket 08, owner 2026-10-20). Null prints
    /// none. Frozen onto each Report Card at close.
    extracurricularTable Boolean?
    personalityTable     Boolean?
    /// Who saved it last.
    setByUserId  String
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A slot's own Grade Weights and KKTP (grading-and-report-card 01, owner
/// 2026-10-13), set by its Answering Teacher. A slot is Class x Subject x Semester:
/// an ended assignment and its successor share one row, as they share their
/// Assessments. A null value follows the school's, so the weights and the KKTP may
/// each be the slot's own or the school's. Clearing them nulls the columns, and the
/// row stays. Not audited: the row says who saved it last.
model SlotGradeSetting {
    id          String   @id @default(cuid())
    schoolId    String
    classId     String
    subjectId   String
    semesterId  String
    /// As on SchoolGradeSetting: all four set or all four null.
    weightTugas Int?
    weightKuis  Int?
    weightUts   Int?
    weightUas   Int?
    kktp        Int?
    /// Who saved it last.
    setByUserId String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
    subject  Subject  @relation(fields: [subjectId], references: [id])
    semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

    @@unique([classId, subjectId, semesterId])
    @@index([schoolId])
}

/// The Answering Teacher's Description of one Student in one slot
/// (grading-and-report-card 03, owner 2026-10-13), shown on the Report Card. Optional
/// (owner, 2026-10-18): written when the Teacher wishes, so finalising never waits for
/// one. Plain text, at most 1,000 characters (owner, 2026-10-17). A slot is Class x
/// Subject x Semester, so an ended assignment's successor reads and changes its
/// predecessor's. Written only for a Student the slot reports for and still in the
/// School (grading.reporting.js). Changed in place; clearing it nulls the text and the
/// row stays. Not audited: the row says who wrote it last.
model SlotDescription {
    id               String   @id @default(cuid())
    schoolId         String
    classId          String
    subjectId        String
    semesterId       String
    studentProfileId String
    text             String?
    /// Who wrote it last.
    writtenByUserId  String
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
    subject        Subject        @relation(fields: [subjectId], references: [id])
    semester       Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

    @@unique([classId, subjectId, semesterId, studentProfileId])
    @@index([schoolId])
}

/// The Homeroom Teacher's Note on one Student for one Semester
/// (grading-and-report-card 03, owner 2026-10-13), shown on the Report Card. Required
/// since 2026-10-18 (owner: the Homeroom Teacher gives each Student advice): closing the
/// Semester (ticket 05) waits for every Student's, and the readiness board (ticket 04)
/// names the ones missing. Plain text, at most 1,000 characters. Written by the Homeroom
/// Teacher of the Class the Student is placed in now, so a mover's is their new Class's
/// (owner, 2026-10-17); the row names no Class, and follows them. Clearing it nulls the
/// text and the row stays, missing again. Not audited: the row says who wrote it last.
model HomeroomNote {
    id               String   @id @default(cuid())
    schoolId         String
    semesterId       String
    studentProfileId String
    text             String?
    /// Who wrote it last.
    writtenByUserId  String
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    semester       Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

    @@unique([semesterId, studentProfileId])
    @@index([schoolId])
}

/// A slot finalised by its Answering Teacher (grading-and-report-card 04, owner
/// 2026-10-13), while its Semester is FINALIZING. A slot is Class x Subject x Semester,
/// so an ended assignment's successor finalises and undoes it too. While a row is live
/// (undoneAt null) the slot is locked: its weights and KKTP, its Descriptions, and every
/// staff write on its Assessments. Undoing it keeps the row, so the history of who
/// finalised and undid stays; one live row per slot - a partial unique index in
/// migration SQL.
model SlotFinalisation {
    id                String    @id @default(cuid())
    schoolId          String
    classId           String
    subjectId         String
    semesterId        String
    /// The settings the slot's grades were computed with when it was finalised - the
    /// weights, the KKTP and the school's Remedial Rule, each with its source - read in
    /// place of the live ones while the row is live (owner, 2026-10-18), so a change to
    /// the school's defaults no longer moves a finalised grade.
    settings          Json
    finalisedByUserId String
    finalisedAt       DateTime  @default(now())
    undoneByUserId    String?
    undoneAt          DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
    subject  Subject  @relation(fields: [subjectId], references: [id])
    semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

    @@index([schoolId])
    @@index([semesterId])
}

/// A Student's Report Card for one Semester (grading-and-report-card 05, owner
/// 2026-10-13 and 2026-10-19): written when the Principal closes the Semester, in the
/// close's transaction, and never recomputed. A reopen's next close writes the next
/// version (ticket 06); the newest counts.
/// - Written for each Student with a live profile, placed in a Class of the year at
///   close, who sat in a Class of the year during the Semester.
/// - The words it shows are copied at close beside the ids - the School, the Student,
///   the Class, the Homeroom Teacher and the Principal - so a later rename does not
///   change it, and the same version always prints the same document (ticket 07).
/// - Append-only in the database: a trigger refuses every UPDATE, and every DELETE
///   unless the transaction set lms.allow_report_card_delete, which only the test-data
///   cleanup does.
model ReportCard {
    id                  String   @id @default(cuid())
    schoolId            String
    semesterId          String
    studentProfileId    String
    /// 1 at the first close.
    version             Int
    /// The Class the Student was placed in at close.
    classId             String
    /// The date the Principal chose for it, a calendar day.
    reportDate          DateTime
    schoolName          String
    /// The School's NPSN and city at close, for the printed Report Card's heading and the
    /// place beside its date (ticket 07, owner 2026-10-20). Null on one written before.
    schoolNpsn          String?
    schoolCity          String?
    /// The letterhead at close (ticket 10): the School's address, phone and logo file.
    /// Null on one written before, or where the School had none. The logo's key never
    /// leaves the server.
    schoolAddress       String?
    schoolPhone         String?
    schoolLogoKey       String?
    studentName         String
    nisn                String
    className           String
    /// The phase (fase) of the Class's Grade Level at close (ticket 07). Null on one
    /// written before.
    phase               String?
    academicYearLabel   String
    semesterOrdinal     Int
    /// Null when the Class had no Homeroom Teacher at close.
    homeroomTeacherName String?
    homeroomTeacherNip  String?
    principalName       String
    principalNip        String?
    /// Confirmed Sessions of the Semester, any Class, as attendanceCounts counts them.
    sick                Int
    excused             Int
    absent              Int
    /// The Homeroom Teacher's Note, which closing requires.
    note                String
    /// The School's choice of the two blank tables at close (ticket 08), so a closed
    /// Report Card keeps the form it was closed with. False on one written before.
    extracurricularTable Boolean @default(false)
    personalityTable     Boolean @default(false)
    /// The year's Promotion Outcome, on an even Semester's only (ticket 09, owner
    /// 2026-10-20): the Homeroom Teacher's decision, or PROMOTED - GRADUATED on the top
    /// grade - for a Student whose every Final Grade of both Semesters reaches its KKTP.
    /// With the grade level it leads to, null for GRADUATED. What Rollover reads.
    promotionOutcome    PromotionOutcome?
    nextGradeLevel      Int?
    closedByUserId      String
    createdAt           DateTime @default(now())

    school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    semester       Semester            @relation(fields: [semesterId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
    class          Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
    subjects       ReportCardSubject[]

    @@unique([semesterId, studentProfileId, version])
    @@index([schoolId])
    @@index([classId, semesterId])
}

/// One Subject on a Report Card: its Final Grade, rounded once (ticket 02), the KKTP and
/// the Description it was reported with, from the slot that reports the Student - a
/// mover's last Class's, or an earlier one's for a Subject only it had. Every Subject
/// on one has a grade: closing refuses while one has none (owner, 2026-10-19).
/// Append-only, with its Report Card.
model ReportCardSubject {
    id           String  @id @default(cuid())
    schoolId     String
    reportCardId String
    subjectId    String
    /// The Class whose slot reported it.
    classId      String
    /// Its place on the Report Card: the national catalog's order, then the school's
    /// own Subjects by name.
    position     Int
    subjectCode  String
    subjectName  String
    finalGrade   Int
    kktp         Int
    /// Each type's average after the Remedial Rule, rounded once, half up, from the exact
    /// value (ticket 08). Null where the type has nothing that counts or is weighted 0, and
    /// on one written before.
    averageTugas Int?
    averageKuis  Int?
    averageUts   Int?
    averageUas   Int?
    description  String?

    school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
    subject    Subject    @relation(fields: [subjectId], references: [id])
    class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)

    @@unique([reportCardId, subjectId])
    @@index([schoolId])
}

/// A student moved from one class to another inside the school (ticket 16). The
/// membership stays ACTIVE throughout; only the placement changes.
///
/// Asked for by the homeroom teacher of the class the student sits in, and
/// decided by the homeroom teacher of the class they would move to (owner,
/// 2026-09-24) - the Principal takes no part. Both classes are in the same ACTIVE
/// academic year; the grade may differ. ACTIVE means the move happened: the old
/// ClassMembership got endedAt and a new one opened in toClass.
///
/// At most one PENDING move per student - a partial unique index in migration SQL.
model ClassMove {
    id                String         @id @default(cuid())
    schoolId          String
    studentProfileId  String
    fromClassId       String
    toClassId         String
    requestedByUserId String
    /// Why, as the origin homeroom teacher put it. Optional.
    reason            String?
    status            ApprovalStatus @default(PENDING)
    requestedAt       DateTime       @default(now())
    decidedByUserId   String?
    decidedAt         DateTime?
    rejectionReason   String?
    createdAt         DateTime       @default(now())
    updatedAt         DateTime       @updatedAt

    school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
    fromClass      Class          @relation("ClassMoveFrom", fields: [fromClassId], references: [id], onDelete: Cascade)
    toClass        Class          @relation("ClassMoveTo", fields: [toClassId], references: [id], onDelete: Cascade)

    @@index([schoolId, status])
    @@index([fromClassId, status])
    @@index([toClassId, status])
    @@index([studentProfileId])
}

/// A Teacher's or a Student's request to leave the school (ticket 17). Leaving is
/// not theirs alone to do: a school needs a resignation letter on file (owner,
/// 2026-09-24), so the letter is uploaded with the request and the Principal
/// decides. ACTIVE means approved - endMembership() ran in the same transaction.
/// A member holding neither role (a guardian) still leaves at once.
///
/// The letter is the school's record, so unlike a KTP it is kept after the
/// decision. At most one PENDING request per membership - a partial unique index
/// in migration SQL.
model LeaveRequest {
    id                String         @id @default(cuid())
    schoolId          String
    membershipId      String
    reason            String
    letterStoragePath String
    status            ApprovalStatus @default(PENDING)
    requestedAt       DateTime       @default(now())
    decidedByUserId   String?
    decidedAt         DateTime?
    rejectionReason   String?
    createdAt         DateTime       @default(now())
    updatedAt         DateTime       @updatedAt

    school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    membership SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

    @@index([schoolId, status])
    @@index([membershipId])
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// In-app only, polled. Nothing here is ever emailed.
model Notification {
    id                    String    @id @default(cuid())
    schoolId              String
    recipientMembershipId String
    type                  String
    title                 String
    body                  String
    readAt                DateTime?
    createdAt             DateTime  @default(now())

    school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
    recipient SchoolMembership @relation(fields: [recipientMembershipId], references: [id], onDelete: Cascade)

    @@index([recipientMembershipId, readAt])
}

/// Append-only log of every approval decision (ADR-0003).
///
/// This one IS polymorphic, and that is deliberate: it records what happened
/// rather than the state anything is read from, so it costs no referential
/// integrity that matters. schoolId is null for school-registration decisions,
/// which happen before any school exists.
model ApprovalAudit {
    id          String         @id @default(cuid())
    schoolId    String?
    subjectType String
    subjectId   String
    action      ApprovalAction
    actorUserId String
    reason      String?
    createdAt   DateTime       @default(now())

    school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

    @@index([schoolId, createdAt])
    @@index([subjectType, subjectId])
}
